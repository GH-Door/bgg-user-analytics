# 실제 값을 채운 뒤 .env로 복사해서 사용

# BGG XML API — 2025-10경부터 등록 후 발급받는 토큰이 없으면 모든 요청이 401.
# 발급: https://boardgamegeek.com/using_the_xml_api 안내에 따라 등록 신청 후 승인 시 발급됨.
BGG_API_TOKEN=your_bgg_api_token_here

# GCP / BigQuery
GCP_PROJECT_ID=bgg-user-analytics
BQ_DATASET_RAW=bgg_raw
BQ_DATASET_STAGING=bgg_staging
BQ_DATASET_MART=bgg_mart

# 서비스 계정 키 파일을 쓰는 경우에만 아래 주석을 풀고 경로를 채운다.
# gcloud auth application-default login을 썼다면(이 프로젝트의 기본 방식)
# 이 줄은 비워둔다 — 값이 설정되면 ADC보다 이 파일을 우선 사용하려 들어서
# "File ... was not found" 에러가 난다.
# GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json
